# 复制为 .env 后按需修改（Bun 会自动读取 .env）
PORT=3000
HOST=0.0.0.0

# ---- 部署（docker compose 用 Caddy 自动签 HTTPS 时必填）----
# 域名要先在 DNS 里把 A 记录指向服务器 IP
DOMAIN=
# 证书到期提醒邮箱
ACME_EMAIL=

SITE_NAME=夜谭
SITE_TAGLINE=把说不出口的经历，留在这里

DB_PATH=data/forum.db
UPLOAD_DIR=uploads

# 登录有效期（天）
SESSION_DAYS=30

# 上传限制
MAX_UPLOAD_BYTES=8388608
MAX_FILES_PER_POST=6

# 1 = 新帖需人工审核后才公开
POST_NEEDS_REVIEW=0

# 1 = 登录页显示演示账号一键登录（生产环境务必改成 0）
DEMO_MODE=1

# 部署在 Nginx/Caddy 之后时设为 1
TRUST_PROXY=1
